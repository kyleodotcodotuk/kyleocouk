# Image Processing Server Configuration

# Server Port
PORT=3001

# Frontend Image Upload API URL
# Used in React components to connect to the image processing server
REACT_APP_IMAGE_UPLOAD_URL=http://localhost:3001

# Save processed images to disk
# Set to false if only processing in-memory
SAVE_UPLOADS=true

# Directory for storing processed images
UPLOAD_DIR=public/uploads

# Optional: Node environment
NODE_ENV=development
